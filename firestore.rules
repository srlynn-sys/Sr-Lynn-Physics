rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /physics_results/{studentId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'id', 'name', 'score', 'total', 'updatedAt'
        ]) &&
        request.resource.data.id == studentId &&
        request.resource.data.name is string &&
        request.resource.data.score is int &&
        request.resource.data.total is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.total == 50 &&
        request.resource.data.score <= request.resource.data.total &&
        !exists(/databases/$(database)/documents/physics_results/$(studentId));

      allow update, delete: if false;
    }

    match /security_violations/{studentId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly([
          'id', 'reason', 'violationCount', 'retryUsed', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == studentId &&
        request.resource.data.reason is string &&
        request.resource.data.violationCount == 1 &&
        request.resource.data.retryUsed == false &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        !exists(/databases/$(database)/documents/security_violations/$(studentId));

      allow update: if
        resource.data.id == studentId &&
        resource.data.violationCount == 1 &&
        request.resource.data.keys().hasOnly([
          'id', 'reason', 'violationCount', 'retryUsed', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.id == studentId &&
        request.resource.data.reason is string &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is timestamp &&
        (
          (request.resource.data.violationCount == 1 &&
           request.resource.data.retryUsed == true) ||
          (request.resource.data.violationCount == 2 &&
           request.resource.data.retryUsed == true)
        );

      allow delete: if false;
    }
  }
}
