rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /physics_results/{studentId} {
      allow read, write: if true;
    }

    match /physics_results_ch1_3/{studentId} {
      allow read, write: if true;
    }

    match /physics_official_results/{studentId} {
      allow read, write: if true;
    }

    match /physics_conceptual_results/{studentId} {
      allow read, write: if true;
    }

    match /attendance_records/{document} {
      allow read, write: if true;
    }

    match /participation_records/{document} {
      allow read, write: if true;
    }

    match /homework_records/{document} {
      allow read, write: if true;
    }

    match /admin_settings/{document} {
      allow read, write: if true;
    }
  }
}
