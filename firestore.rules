rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /physics_results/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','score','total','updatedAt']) && request.resource.data.id == studentId && request.resource.data.name is string && request.resource.data.score is int && request.resource.data.total is int && request.resource.data.score >= 0 && request.resource.data.total == 50 && request.resource.data.score <= request.resource.data.total && !exists(/databases/$(database)/documents/physics_results/$(studentId));
      allow update, delete: if false;
    }
    match /physics_results_ch1_3/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','score','total','updatedAt']) && request.resource.data.id == studentId && request.resource.data.name is string && request.resource.data.score is int && request.resource.data.total is int && request.resource.data.score >= 0 && request.resource.data.total == 100 && request.resource.data.score <= request.resource.data.total && !exists(/databases/$(database)/documents/physics_results_ch1_3/$(studentId));
      allow update, delete: if false;
    }
    match /physics_official_results/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','score','total','testType','updatedAt']) && request.resource.data.id == studentId && request.resource.data.name is string && request.resource.data.score is int && request.resource.data.total == 100 && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total && request.resource.data.testType == 'official' && !exists(/databases/$(database)/documents/physics_official_results/$(studentId));
      allow update, delete: if false;
    }
  }
}
