rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /physics_results/{studentId} {
      // Results are readable for the live result board.
      allow read: if true;

      // A result can be created once. Existing results cannot be overwritten
      // or deleted from the public client.
      allow create: if
        request.resource.data.keys().hasOnly([
          'id', 'name', 'score', 'total', 'updatedAt'
        ]) &&
        request.resource.data.id == studentId &&
        request.resource.data.name is string &&
        request.resource.data.score is int &&
        request.resource.data.total is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.total == 50 &&
        request.resource.data.score <= request.resource.data.total &&
        !exists(/databases/$(database)/documents/physics_results/$(studentId));

      allow update, delete: if false;
    }

    // Anti-cheating lock: once an eligible student's exam session is
    // interrupted, the client records a permanent violation for that ID.
    match /security_violations/{studentId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['id', 'reason', 'createdAt']) &&
        request.resource.data.id == studentId &&
        request.resource.data.reason is string &&
        !exists(/databases/$(database)/documents/security_violations/$(studentId));
      allow update, delete: if false;
    }
  }
}
